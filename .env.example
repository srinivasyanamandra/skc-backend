# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Admin Credentials
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_PASSWORD_2=second_admin_password

# JWT Configuration
JWT_SECRET=your-secret-key-must-be-at-least-32-bytes-long-for-hs256-algorithm

# SMTP Configuration (Spring Mail)
# For Hostinger (production):
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@srikarthikeyacaterers.in
MAIL_PASSWORD=your_hostinger_email_password

# For Gmail (testing):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_gmail_app_password_16_chars

# Optional: Disable email sending for testing
# MAIL_DISABLED=true

# Review Link Base URL
REVIEW_BASE_URL=http://localhost:3000

# Active Profile
SPRING_PROFILES_ACTIVE=local
